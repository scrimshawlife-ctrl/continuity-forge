# Continuity Forge — bare-metal Linux environment
# Install as: /etc/continuity-forge/continuity-forge.env  (mode 0640, root:continuity-forge)
# Do NOT commit real secrets. Copy this file and edit.

# --- Process / environment role ---
# production|prod blocks POST /v1/tenants/bootstrap-dev even if CF_BOOTSTRAP_DEV_TENANT=1
CF_ENV=production

# --- Listen ---
# Used by systemd ExecStart; uvicorn binds here
CF_HOST=127.0.0.1
CF_PORT=8080

# --- Auth ---
# Require Bearer API keys for mutating/tenant routes
CF_AUTH_REQUIRED=1
# NEVER enable in real production (bootstrap-dev is local-only)
CF_BOOTSTRAP_DEV_TENANT=0

# --- Durable stores (pick one primary) ---
# 1) Postgres (preferred for multi-process / multi-host)
# CF_DATABASE_URL=postgresql://continuity:CHANGE_ME@127.0.0.1:5432/continuity_forge
#
# 2) Filesystem (single-node durable, no Postgres required)
CF_STORE_ROOT=/var/lib/continuity-forge

# --- Optional S3 / MinIO artifacts (PROPOSED candidates) ---
# CF_S3_ENDPOINT=http://127.0.0.1:9000
# CF_S3_BUCKET=continuity-forge
# CF_S3_ACCESS_KEY=minioadmin
# CF_S3_SECRET_KEY=CHANGE_ME
# CF_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# --- Provider gateway ---
# mock | openai | runway | http
CF_PROVIDER=mock
# OPENAI_API_KEY=
# CF_OPENAI_IMAGE_MODEL=dall-e-3
# RUNWAY_API_KEY=
# CF_PROVIDER_HTTP_URL=http://127.0.0.1:8090/generate

# --- Temporal worker (optional; only if running continuity-forge-worker) ---
# CF_TEMPORAL_HOST=127.0.0.1:7233
# CF_TEMPORAL_NAMESPACE=default
# CF_TEMPORAL_TASK_QUEUE=continuity-forge-kernel
